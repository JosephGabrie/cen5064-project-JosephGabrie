# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Database Connection String (Supabase PostgreSQL Pooler)
# Format: postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
SUPABASE_CONNECTION_STRING=postgresql://postgres.your-project-id:your_db_password@aws-0-us-east-2.pooler.supabase.com:5432/postgres

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Optional Frontend Auto-Login (uncomment to auto-login on startup)
# NEXT_PUBLIC_AUTO_LOGIN_USER=
# NEXT_PUBLIC_AUTO_LOGIN_PASSWORD=
